---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import logo from '../assets/brand/logo.png';
import shareDefault from '../assets/hero/carr1.webp';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { englishLive, languages, url, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  /** Which page this is, so the language switcher and hreflang tags can find its twin. */
  route: RouteKey;
  /** Product slug for catalogue detail pages. */
  slug?: string;
  title: string;
  description: string;
  variant?: 'overlay' | 'solid';
  current?: 'inicio' | 'catalogo' | 'causa' | 'equipo' | 'historia' | 'b2b' | 'contacto';
  /** Photo shown when the page is shared on WhatsApp, Instagram, etc. Defaults to the home hero. */
  shareImage?: ImageMetadata;
}
const { lang, route, slug, title, description, variant = 'solid', current, shareImage = shareDefault } = Astro.props;
const fullTitle = title === site.name ? title : `${title} · ${site.name}`;
const icon = await getImage({ src: logo, width: 96, height: 96, format: 'png' });
const alternates = Object.fromEntries(languages.map((l) => [l, url(l, route, slug)])) as Record<Lang, string>;
const noindex = lang === 'en' && !englishLive;
// Link previews and hreflang need full addresses (https://lobitosponchos.com/...), not paths.
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(url(lang, route, slug));
const share = await getImage({ src: shareImage, width: 1200, height: 630, fit: 'cover', position: 'attention', format: 'jpg' });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_PE'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(share.src)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={icon.src} />
    {englishLive && languages.map((l) => <link rel="alternate" hreflang={l} href={absolute(alternates[l])} />)}
    <slot name="head" />
  </head>
  <body class="overflow-x-clip">
    <Header lang={lang} variant={variant} current={current} alternates={alternates} />
    <slot />
    <Footer lang={lang} />

    <script>
      import { initAnimations } from '../scripts/animations';
      initAnimations();
      document.addEventListener('astro:page-load', initAnimations);
    </script>
  </body>
</html>
