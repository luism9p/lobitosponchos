---
import BaseLayout from '../layouts/BaseLayout.astro';
import CausaBlock from '../components/CausaBlock.astro';
import Chip from '../components/Chip.astro';
import Img from '../components/Img.astro';
import Lines from '../components/Lines.astro';
import { url, useTranslations, type Lang } from '../i18n';
import jovenes from '../assets/causa/jovenes.jpeg';
import abuela from '../assets/causa/abuela.jpeg';
import feria from '../assets/causa/feria.jpeg';
import playa from '../assets/causa/playa.jpeg';
import olas from '../assets/hero/carr3.webp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t, list } = useTranslations(lang);

interface Chapter {
  title: string;
  photoAlt: string;
  p1: string;
  p2: string;
}
// Photos for each chapter of `story.chapters`, in the same order.
const chapterPhotos = [
  { photo: jovenes, ratio: 'aspect-[4/5]', position: '50% 40%' },
  { photo: abuela, ratio: 'aspect-[3/4]', position: '50% 15%' },
  { photo: feria, ratio: 'aspect-[4/5]', position: '50% 55%' },
  { photo: playa, ratio: 'aspect-[3/4]', position: '50% 85%' },
] as const;
const chapters = list<Chapter>('story.chapters').map((c, i) => ({ ...c, ...chapterPhotos[i], n: String(i + 1).padStart(2, '0') }));
const timeline = list<{ when: string; title: string; text: string }>('story.timeline');

const body = 'm-0 text-base leading-[1.65] text-pretty';
---

<BaseLayout
  lang={lang}
  route="historia"
  title={t('story.seoTitle')}
  description={t('story.seoDescription')}
  variant="solid"
  current="historia"
>
  <main>
    <section class="mx-auto max-w-[1180px] px-5 pt-[150px]">
      <Chip class="mb-[22px]">{t('story.chip')}</Chip>
      <div class="grid grid-cols-1 items-start gap-6 split:grid-cols-[1.4fr_1fr]">
        <div>
          <h1 class="m-0 mb-[22px] inline-block border-b-[3px] border-black pb-4 font-display text-[clamp(42px,6.4vw,88px)] font-normal uppercase leading-[.98]"><Lines text={t('story.title')} /></h1>
          <p class="m-0 max-w-[580px] text-[19px] leading-[1.55] text-pretty">{t('story.lead')}</p>
        </div>
        <div class="flex flex-col items-start gap-3.5 split:items-end">
          <div class="flex size-[150px] -rotate-6 flex-col items-center justify-center gap-1.5 rounded-full border-[1.5px] border-black bg-cream p-2.5 text-center">
            <span class="font-display text-sm uppercase leading-[1.1]"><Lines text={t('story.stampTop')} /></span>
            <span class="h-[1.5px] w-[34px] bg-black"></span>
            <span class="text-[9px] uppercase tracking-[0.14em]">{t('story.stampBottom')}</span>
          </div>
        </div>
      </div>
    </section>

    <section aria-hidden="true" class="mt-14 border-y-2 border-black">
      <div class="grid h-16 grid-cols-2">
        <div class="bg-[repeating-linear-gradient(-45deg,#000_0_10px,#2b2b2b_10px_20px)]"></div>
        <div class="bg-white"></div>
      </div>
    </section>

    {chapters.map((c, i) => (
      <CausaBlock
        id={`capitulo-${c.n}`}
        number={c.n}
        counter={t('story.counter', { n: c.n })}
        photo={c.photo}
        alt={c.photoAlt}
        ratio={c.ratio}
        position={c.position}
        photoSide={i % 2 === 0 ? 'left' : 'right'}
      >
        <Fragment slot="title">{c.title}</Fragment>
        <p class="m-0 text-lg font-medium leading-[1.6] text-pretty">{c.p1}</p>
        <p class={body}>{c.p2}</p>
      </CausaBlock>
    ))}

    <!-- Lobitos history -->
    <section id="lobitos" class="scroll-mt-[76px] border-b-2 border-black">
      <div class="grid grid-cols-1 items-stretch split:grid-cols-[minmax(0,.9fr)_minmax(0,1.1fr)]">
        <div class="relative border-b-2 border-black bg-black split:border-b-0 split:border-r-2">
          <div class="relative aspect-[3/4] overflow-hidden split:sticky split:top-[76px] split:aspect-auto split:h-[calc(100svh-76px)]">
            <Img src={olas} alt={t('story.townPhotoAlt')} sizes="(min-width: 860px) 45vw, 100vw" widths={[640, 960, 1280, 2000]} position="22% 50%" class="absolute inset-0 size-full object-cover" />
            <span class="absolute left-3.5 top-3.5 z-[2] border-[1.5px] border-black bg-white px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-black">{t('story.townChip')}</span>
          </div>
        </div>
        <div class="flex flex-col gap-6 bg-cream px-5 pb-16 pt-12 split:px-12 split:pt-[72px]">
          <h2 class="m-0 font-display text-[clamp(34px,4.6vw,64px)] font-normal uppercase leading-[.98]"><Lines text={t('story.townTitle')} /></h2>
          <p class="m-0 max-w-[520px] text-lg leading-[1.6] text-pretty">{t('story.townLead')}</p>
          <ol class="m-0 flex list-none flex-col border-l-2 border-black p-0">
            {timeline.map((item) => (
              <li class="relative flex flex-col gap-1.5 pb-7 pl-6 last:pb-0">
                <span aria-hidden="true" class="absolute -left-[7px] top-1 size-3 rounded-full border-2 border-black bg-white"></span>
                <span class="text-[11px] font-semibold uppercase tracking-[0.2em] opacity-70">{item.when}</span>
                <h3 class="m-0 font-display text-[clamp(22px,2.2vw,30px)] font-normal uppercase leading-none">{item.title}</h3>
                <p class={body}>{item.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="bg-black px-5 pb-24 pt-[100px] text-center text-white">
      <Chip tone="dark" class="mb-7 -rotate-[1.5deg] px-4 py-[7px]">{t('story.closingChip')}</Chip>
      <h2 class="mx-auto mb-10 max-w-[1000px] font-display text-[clamp(30px,5.2vw,64px)] font-normal uppercase leading-[1.06] text-balance">{t('story.closingTitle')}</h2>
      <div class="flex flex-wrap justify-center gap-3.5">
        <a href={url(lang, 'causa')} class="inline-block border-2 border-white bg-white px-7 py-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-black hover:no-underline">{t('story.cause')}</a>
        <a href={url(lang, 'equipo')} class="inline-block border-2 border-white bg-black px-7 py-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-white hover:bg-white hover:text-black hover:no-underline">{t('story.team')}</a>
        <a href={url(lang, 'catalogo')} class="inline-block border-2 border-white bg-black px-7 py-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-white hover:bg-white hover:text-black hover:no-underline">{t('story.collection')}</a>
      </div>
    </section>
  </main>
</BaseLayout>
