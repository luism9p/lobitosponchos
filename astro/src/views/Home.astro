---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Img from '../components/Img.astro';
import Lines from '../components/Lines.astro';
import SectionBar from '../components/SectionBar.astro';
import InstagramReel from '../components/InstagramReel.astro';
import { categorias, catalogoUrl } from '../data/categorias';
import { instagramUrl, site } from '../data/site';
import { url, useTranslations, type Lang } from '../i18n';
import equipoFoto from '../assets/historias/nuestra-causa.webp';
import laOnza from '../assets/historias/la-onza.webp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t, list } = useTranslations(lang);

const aboutLinks = (['historia', 'causa', 'equipo'] as const).map((route) => url(lang, route));
const aboutCards = list<{ title: string; text: string; link: string }>('home.aboutCards').map((card, i) => ({ ...card, href: aboutLinks[i] }));
---

<BaseLayout
  lang={lang}
  route="home"
  title={t('home.seoTitle')}
  description={t('home.seoDescription')}
  variant="overlay"
  current="inicio"
>
  <main>
    <Hero lang={lang} autoplay={7} />

    <SectionBar left={t('home.barLines')} />

    <!-- Categories -->
    <section id="categorias" aria-label={t('home.categoriesLabel')} class="grid grid-cols-2 gap-0.5 border-b-2 border-black bg-black split:grid-cols-4">
      {categorias.map((cat) => {
        const lines = list(`categories.${cat.id}.lines`);
        return (
          <a href={catalogoUrl(lang, cat.id)} class="group @container relative block aspect-square overflow-hidden bg-black text-white hover:no-underline">
            <div class="absolute inset-0">
              <Img src={cat.imagen} alt="" sizes="(min-width: 860px) 25vw, 50vw" widths={[320, 480, 640, 960]} class="size-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-black/[.32]"></div>
            <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-2.5 px-4 pb-[18px] pt-4">
              <span class="font-display text-[clamp(16px,min(12.5cqw,calc((100cqw_-_60px)/5.8)),64px)] uppercase leading-[.9]">
                {lines[0]}{lines[1] && <><br />{lines[1]}</>}
              </span>
              <span class="shrink-0 text-lg leading-none" aria-hidden="true">→</span>
            </div>
            <span class="sr-only">{t(`categories.${cat.id}.name`)}</span>
          </a>
        );
      })}
    </section>

    <SectionBar left={t('home.barPeople')} />

    <!-- About us: story, purpose and people in one place -->
    <section id="nosotros" class="relative overflow-hidden border-b-2 border-black">
      <div class="relative border-b-2 border-black">
        <Img src={equipoFoto} alt={t('home.aboutPhotoAlt')} sizes="100vw" widths={[640, 960, 1280, 1600, 1920, 2560]} position="50% 48%" class="block h-auto w-full split:h-[clamp(240px,22vw,440px)] split:object-cover" />
        <span class="absolute bottom-3 left-3 inline-block border-2 border-black bg-white px-2.5 pb-0.5 pt-1.5 font-display text-[clamp(24px,4vw,48px)] uppercase leading-[.9] split:bottom-6 split:left-[34px]">{t('home.aboutChip')}</span>
      </div>
      <div class="mx-auto grid w-full max-w-[1180px] grid-cols-1 gap-8 px-5 pb-14 pt-12 split:grid-cols-[1fr_1.1fr] split:gap-14 split:pb-8 split:pt-9">
        <h2 class="m-0 font-display text-[clamp(36px,5vw,64px)] font-normal uppercase leading-[.95] tracking-[-0.02em]"><Lines text={t('home.aboutTitle')} /></h2>
        <p class="m-0 self-end text-lg leading-[1.6] text-pretty">{t('home.aboutLead')}</p>
      </div>
      <div class="mx-auto grid w-full max-w-[1180px] grid-cols-1 gap-8 px-5 pb-16 md:grid-cols-3 md:gap-10 split:pb-10">
        {aboutCards.map((card) => (
          <a href={card.href} class="group flex flex-col gap-2.5 border-t-2 border-black pt-5 text-black hover:no-underline">
            <h3 class="m-0 font-display text-[clamp(24px,2.4vw,32px)] font-normal uppercase leading-none">{card.title}</h3>
            <p class="m-0 text-[15px] leading-[1.55] text-pretty">{card.text}</p>
            <span class="mt-auto self-start pt-1 text-xs font-semibold uppercase tracking-[0.14em] underline-offset-[6px] decoration-[1.5px] group-hover:underline">{card.link}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Life in Lobitos: the Instagram clip beside the text, alternating with the B2B layout below -->
    <section id="vida" class="border-b-2 border-black bg-cream">
      <div class="mx-auto grid w-full max-w-[1180px] grid-cols-1 items-center gap-10 px-5 py-14 md:grid-cols-[minmax(0,380px)_1fr] md:gap-16 split:py-[88px]">
        <div class="flex flex-col items-start gap-6 md:order-2">
          <h2 class="m-0 font-display text-[clamp(38px,5.4vw,80px)] font-normal uppercase leading-[.95] tracking-[-0.02em]">{t('home.lifeTitle')}</h2>
          <p class="m-0 max-w-[480px] text-lg leading-[1.6] text-pretty">{t('home.lifeText')}</p>
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-t-[1.5px] border-black pt-4">
            <span class="font-display text-[34px] leading-none">12.4K</span>
            <span class="whitespace-nowrap text-[11px] uppercase tracking-[0.2em] opacity-70">{t('home.lifeFollowersLabel')} · {site.instagramHandle}</span>
          </div>
          <a href={instagramUrl} target="_blank" rel="noopener" class="bg-black px-[26px] py-3.5 text-xs uppercase tracking-[0.18em] text-white hover:bg-[#222] hover:text-white hover:no-underline">{t('home.lifeFollow')} ↗</a>
        </div>
        <div class="flex justify-center md:order-1 md:justify-start">
          <InstagramReel lang={lang} />
        </div>
      </div>
    </section>

    <!-- B2B -->
    <section id="b2b" class="relative overflow-hidden border-b-2 border-black bg-white">
      <SectionBar tone="dark" left={t('home.b2bBarLeft')} />
      <div class="grid grid-cols-1 items-stretch md:grid-cols-[55fr_45fr]">
        <div class="relative z-[2] flex flex-col justify-center gap-[26px] px-5 py-12 md:px-10 md:py-16">
          <h2 class="m-0 self-start font-display text-[clamp(36px,6vw,84px)] font-normal uppercase leading-[.9]"><Lines text={t('home.b2bTitle')} /></h2>
          <p class="m-0 max-w-[520px] text-lg leading-[1.6] text-pretty">{t('home.b2bText')}</p>
          <a href={url(lang, 'b2b')} class="self-start bg-black px-[26px] py-3.5 text-xs uppercase tracking-[0.18em] text-white hover:bg-[#222] hover:text-white hover:no-underline">{t('home.b2bLink')}</a>
        </div>
        <div class="relative min-h-[420px] overflow-hidden border-t-2 border-black md:border-t-0 md:border-l-2 split:min-h-[560px]">
          <Img src={laOnza} alt={t('home.b2bPhotoAlt')} sizes="(min-width: 768px) 45vw, 100vw" widths={[480, 768, 960, 1200]} class="absolute inset-0 size-full object-cover object-center" />
          <span class="absolute bottom-4 left-4 border-[1.5px] border-black bg-white px-4 py-3 text-xs font-bold uppercase tracking-[0.06em]">{t('home.b2bCaption')}</span>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
