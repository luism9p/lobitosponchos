---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chip from '../components/Chip.astro';
import Img from '../components/Img.astro';
import Lines from '../components/Lines.astro';
import { whatsappUrl } from '../data/site';
import { url, useTranslations, type Lang } from '../i18n';
import feria from '../assets/causa/feria.jpeg';
import abuela from '../assets/causa/abuela.jpeg';
import playa from '../assets/causa/playa.jpeg';
import jovenes from '../assets/causa/jovenes.jpeg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t, list } = useTranslations(lang);

interface Value {
  title: string;
  text: string;
  photoAlt: string;
}
// Photos for each item of `cause.values`, in the same order. The first value gets a link to
// share ideas on WhatsApp, the second a link to the team page.
const valuePhotos = [
  { photo: feria, position: '50% 55%', link: { href: whatsappUrl(t('wa.collab')), label: t('cause.collabLink'), external: true } },
  { photo: abuela, position: '50% 15%', link: { href: url(lang, 'equipo'), label: t('cause.grandmothersLink'), external: false } },
  { photo: playa, position: '50% 85%', link: null },
  { photo: jovenes, position: '50% 40%', link: null },
];
const values = list<Value>('cause.values').map((v, i) => ({ ...v, ...valuePhotos[i], id: `causa-${i + 1}` }));
---

<BaseLayout
  lang={lang}
  route="causa"
  title={t('cause.seoTitle')}
  description={t('cause.seoDescription')}
  variant="solid"
  current="causa"
>
  <main>
    <section class="mx-auto max-w-[1180px] px-5 pt-[150px]">
      <div class="mb-[22px]"><Chip>{t('cause.chip')}</Chip></div>
      <h1 class="m-0 mb-[22px] inline-block border-b-[3px] border-black pb-4 font-display text-[clamp(42px,6.4vw,88px)] font-normal uppercase leading-[.98]"><Lines text={t('cause.title')} /></h1>
      <p class="m-0 max-w-[580px] text-[19px] leading-[1.55] text-pretty">{t('cause.lead')}</p>
    </section>

    <div aria-hidden="true" class="mt-14 border-b-2 border-black"></div>

    <!-- The four things we care about most -->
    <section class="px-5 py-16 split:py-20">
      <div class="mx-auto mb-12 flex max-w-[1180px] flex-col gap-4">
        <h2 class="m-0 font-display text-[clamp(32px,4.4vw,56px)] font-normal uppercase leading-[1]">{t('cause.valuesTitle')}</h2>
        <p class="m-0 max-w-[620px] text-lg leading-[1.6] text-pretty">{t('cause.valuesIntro')}</p>
      </div>
      <ul class="mx-auto m-0 grid max-w-[1180px] list-none grid-cols-1 gap-x-10 gap-y-14 p-0 md:grid-cols-2">
        {values.map((v) => (
          <li id={v.id} class="flex scroll-mt-[96px] flex-col gap-4">
            <div class="relative aspect-[4/3] overflow-hidden border-2 border-black bg-black">
              <Img src={v.photo} alt={v.photoAlt} sizes="(min-width: 768px) 560px, 100vw" widths={[480, 760, 1120]} position={v.position} class="absolute inset-0 size-full object-cover" />
            </div>
            <h2 class="m-0 font-display text-[clamp(28px,3vw,40px)] font-normal uppercase leading-[1]"><Lines text={v.title} /></h2>
            <p class="m-0 max-w-[520px] text-lg leading-[1.6] text-pretty">{v.text}</p>
            {v.link && (
              <a href={v.link.href} target={v.link.external ? '_blank' : undefined} rel={v.link.external ? 'noopener' : undefined} class="self-start border-b-2 border-black pb-[3px] text-xs font-semibold uppercase tracking-[0.14em] text-black hover:border-transparent hover:no-underline">{v.link.label}</a>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="border-t-2 border-black bg-black px-5 pb-24 pt-[100px] text-center text-white">
      <h2 class="mx-auto mb-6 max-w-[1000px] font-display text-[clamp(30px,5.2vw,64px)] font-normal uppercase leading-[1.06] text-balance">{t('cause.closing.title')}</h2>
      <p class="mx-auto mb-10 max-w-[600px] text-[19px] leading-[1.55] text-pretty">{t('cause.closing.text')}</p>
      <div class="flex flex-wrap justify-center gap-3.5">
        <a href={url(lang, 'catalogo')} class="inline-block border-2 border-white bg-white px-7 py-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-black hover:no-underline">{t('cause.closing.collection')}</a>
        <a href={url(lang, 'equipo')} class="inline-block border-2 border-white bg-black px-7 py-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-white hover:bg-white hover:text-black hover:no-underline">{t('cause.closing.team')}</a>
      </div>
    </section>
  </main>
</BaseLayout>
