---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chip from '../components/Chip.astro';
import Lines from '../components/Lines.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { instagramUrl, site, whatsappUrl } from '../data/site';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t } = useTranslations(lang);

const card = 'flex flex-col gap-3 border-2 border-black bg-cream p-6 text-black shadow-[5px_5px_0_#000]';
const label = 'text-[11px] font-semibold uppercase tracking-[0.3em] opacity-70';
const value = 'self-start border-b-2 border-black pb-0.5 text-[clamp(18px,2vw,22px)] font-semibold leading-snug text-black [overflow-wrap:anywhere] hover:border-transparent hover:no-underline';
---

<BaseLayout
  lang={lang}
  route="contacto"
  title={t('contact.seoTitle')}
  description={t('contact.seoDescription')}
  variant="solid"
  current="contacto"
>
  <main class="pb-24">
    <section class="mx-auto max-w-[1180px] px-5 pt-[150px]">
      <div class="mb-[22px]"><Chip>{t('contact.chip')}</Chip></div>
      <h1 class="m-0 mb-[22px] inline-block border-b-[3px] border-black pb-4 font-display text-[clamp(42px,6.4vw,88px)] font-normal uppercase leading-[.98]"><Lines text={t('contact.title')} /></h1>
      <p class="m-0 max-w-[600px] text-[19px] leading-[1.55] text-pretty">{t('contact.lead')}</p>
    </section>

    <section class="mx-auto mt-12 grid max-w-[1180px] grid-cols-1 gap-5 px-5 md:grid-cols-2">
      <!-- WhatsApp is how people order, so it gets the biggest card -->
      <div class="flex flex-col items-start gap-4 border-2 border-black bg-black p-7 text-white shadow-[5px_5px_0_#000] md:col-span-2 md:flex-row md:items-center md:justify-between md:gap-8">
        <div class="flex flex-col gap-3">
          <span class="text-[11px] font-semibold uppercase tracking-[0.3em] opacity-70">WhatsApp</span>
          <a href={whatsappUrl()} target="_blank" rel="noopener" class="font-display text-[clamp(28px,4vw,48px)] uppercase leading-none text-white hover:no-underline">{site.whatsappLabel}</a>
          <p class="m-0 max-w-[460px] text-base leading-[1.55] text-pretty">{t('contact.whatsappText')}</p>
        </div>
        <WhatsAppButton variant="outline-white" class="shrink-0 px-6 py-3.5 text-sm">{t('contact.whatsappBtn')}</WhatsAppButton>
      </div>

      <div class={card}>
        <span class={label}>Instagram</span>
        <a href={instagramUrl} target="_blank" rel="noopener" class={value}>{site.instagramHandle} ↗</a>
        <p class="m-0 text-[15px] leading-[1.55] text-pretty">{t('contact.instagramText')}</p>
      </div>

      <div class={card}>
        <span class={label}>{t('contact.emailLabel')}</span>
        <a href={`mailto:${site.email}`} class={value}>{site.email}</a>
        <p class="m-0 text-[15px] leading-[1.55] text-pretty">{t('contact.emailText')}</p>
      </div>

      <div class={card + ' md:col-span-2'}>
        <span class={label}>{t('contact.whereLabel')}</span>
        <span class="font-display text-[clamp(26px,3vw,36px)] uppercase leading-[.95]"><Lines text={t('footer.place')} /> · {t('footer.country')}</span>
        <p class="m-0 max-w-[640px] text-[15px] leading-[1.55] text-pretty">{t('contact.whereText')}</p>
      </div>
    </section>
  </main>
</BaseLayout>
