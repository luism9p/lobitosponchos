---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chip from '../components/Chip.astro';
import Img from '../components/Img.astro';
import Lines from '../components/Lines.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { equipo, grupos } from '../data/equipo';
import { workawayUrl } from '../data/site';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t, list } = useTranslations(lang);

interface PersonText {
  technique: string;
  name: string;
  bio: string;
}
const texts = list<PersonText>('team.people');
const people = equipo.map((p, i) => ({ ...p, ...texts[i] }));
const groups = grupos.map((g) => ({
  ...g,
  people: g.miembros.map((n) => people.find((p) => p.numero === n)!),
}));

const volunteerFacts = list<{ label: string; value: string }>('team.volunteer.facts');
const volunteerHelp = list('team.volunteer.help');
---

<BaseLayout
  lang={lang}
  route="equipo"
  title={t('team.seoTitle')}
  description={t('team.seoDescription')}
  variant="solid"
  current="equipo"
>
  <main>
    <section class="mx-auto grid max-w-[1180px] grid-cols-1 items-end gap-5 px-5 pt-[104px] split:grid-cols-[auto_1fr] split:gap-14 split:pt-[124px]">
      <div>
        <div class="mb-4"><Chip>{t('team.chip')}</Chip></div>
        <h1 class="m-0 inline-block border-b-[3px] border-black pb-3 font-display text-[clamp(36px,4.6vw,60px)] font-normal uppercase leading-[.98]"><Lines text={t('team.title')} /></h1>
      </div>
      <p class="m-0 max-w-[460px] text-[17px] leading-[1.6] text-pretty">{t('team.lead')}</p>
    </section>

    <div aria-hidden="true" class="mt-10 border-b-2 border-black"></div>

    <!-- The five of us, grouped the way they were photographed -->
    <section class="border-b-2 border-black px-5 py-12 split:py-14">
      <ul class="mx-auto m-0 grid max-w-[1180px] list-none grid-cols-1 gap-x-8 gap-y-12 p-0 xs:grid-cols-2 split:grid-cols-3">
        {groups.map((g) => (
          <li class="flex flex-col gap-5">
            <div class="relative aspect-[4/3] overflow-hidden border-2 border-black bg-black">
              <Img src={g.foto} alt={g.people.map((p) => p.name).join(' & ')} sizes="(min-width: 860px) 380px, (min-width: 620px) 50vw, 100vw" widths={[480, 760]} position={g.posicion} class="absolute inset-0 size-full object-cover" />
              <div class="absolute inset-x-2.5 bottom-2.5 flex justify-between gap-2">
                {g.people.map((p) => (
                  <span class="bg-black px-2 py-0.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-white">{p.apodo}</span>
                ))}
              </div>
            </div>
            {g.people.map((p) => (
              <div class="flex flex-col gap-1.5">
                <span class="text-[10px] font-semibold uppercase tracking-[0.2em] opacity-70">{p.technique}</span>
                <h2 class="m-0 font-display text-[26px] font-normal uppercase leading-[1.05]">{p.apodo}</h2>
                <span class="text-[13px] opacity-70">{p.name}</span>
                <p class="m-0 text-[15px] leading-[1.55] text-pretty">{p.bio}</p>
              </div>
            ))}
          </li>
        ))}
      </ul>
    </section>

    <section id="voluntariado" class="scroll-mt-[76px] border-b-2 border-black bg-white px-5 pb-20 pt-[88px]">
      <div class="mx-auto max-w-[1180px]">
        <Chip class="mb-[22px]">{t('team.volunteer.chip')}</Chip>
        <div class="grid grid-cols-1 items-end gap-6 split:grid-cols-[1fr_1.1fr] split:gap-14">
          <h2 class="m-0 inline-block self-start border-b-[3px] border-black pb-4 font-display text-[clamp(38px,5.6vw,76px)] font-normal uppercase leading-[.98]"><Lines text={t('team.volunteer.title')} /></h2>
          <p class="m-0 text-lg leading-[1.6] text-pretty">{t('team.volunteer.lead')}</p>
        </div>
        <dl class="m-0 mt-10 grid grid-cols-1 border-[1.5px] border-black xs:grid-cols-3">
          {volunteerFacts.map((f, i) => (
            <div class:list={['border-black px-5 py-[18px]', i > 0 && 'border-t-[1.5px] xs:border-l-[1.5px] xs:border-t-0']}>
              <dt class="mb-1.5 text-[10px] uppercase tracking-[0.16em] opacity-60">{f.label}</dt>
              <dd class="m-0 text-[15px] font-semibold leading-snug">{f.value}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-10 grid grid-cols-1 gap-8 split:grid-cols-2 split:gap-14">
          <div class="flex flex-col gap-3">
            <h3 class="m-0 text-[11px] font-semibold uppercase tracking-[0.3em]">{t('team.volunteer.helpTitle')}</h3>
            <ul class="m-0 flex list-none flex-col p-0">
              {volunteerHelp.map((item) => <li class="border-b-[1.5px] border-dashed border-black py-2.5 text-[15px]">→ {item}</li>)}
            </ul>
          </div>
          <div class="flex flex-col items-start gap-4 border-[1.5px] border-black bg-cream p-6">
            <h3 class="m-0 text-[11px] font-semibold uppercase tracking-[0.3em]">{t('team.volunteer.lifeTitle')}</h3>
            <p class="m-0 text-base leading-[1.65] text-pretty">{t('team.volunteer.life')}</p>
            <div class="mt-2 flex flex-wrap items-center gap-4">
              <a href={workawayUrl} target="_blank" rel="noopener" class="inline-block border-2 border-black bg-black px-6 py-3 text-xs font-semibold uppercase tracking-[0.16em] text-white hover:bg-white hover:text-black hover:no-underline">{t('team.volunteer.apply')}</a>
              <WhatsAppButton variant="outline-white" message={t('wa.volunteer')}>{t('team.volunteer.ask')}</WhatsAppButton>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
