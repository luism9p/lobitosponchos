---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chip from '../components/Chip.astro';
import Img from '../components/Img.astro';
import Lines from '../components/Lines.astro';
import { equipo } from '../data/equipo';
import { url, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t, list } = useTranslations(lang);

interface PersonText {
  label: string;
  technique: string;
  name: string;
  bio: string;
  stat1: string;
  stat2: string;
  footLeft: string;
  footRight: string;
}
const texts = list<PersonText>('team.people');
const people = equipo.map((p, i) => ({ ...p, ...texts[i] }));

const statBorders = [
  'border-r-[1.5px] border-b-[1.5px] xs:border-b-0',
  'border-b-[1.5px] xs:border-b-0 xs:border-r-[1.5px]',
  'border-r-[1.5px]',
  '',
];
const stats = list<{ label: string; value: string }>('team.stats').map((s, i) => ({ ...s, border: statBorders[i] }));
const closingValues = list('team.values');
---

<BaseLayout
  lang={lang}
  route="equipo"
  title={t('team.seoTitle')}
  description={t('team.seoDescription')}
  variant="solid"
  current="equipo"
>
  <main>
    <section class="mx-auto max-w-[1180px] px-5 pt-[150px]">
      <Chip class="mb-[22px]">{t('team.chip')}</Chip>
      <div class="grid grid-cols-1 items-start gap-6 split:grid-cols-[1.4fr_1fr]">
        <div>
          <h1 class="m-0 mb-5 inline-block border-b-[3px] border-black pb-4 font-display text-[clamp(42px,6.4vw,88px)] font-normal uppercase leading-[.98]"><Lines text={t('team.title')} /></h1>
          <p class="m-0 max-w-[560px] text-[17px] leading-[1.6] text-pretty">{t('team.lead')}</p>
        </div>
        <div class="flex flex-col items-start gap-3.5 split:items-end">
          <div class="flex size-[150px] -rotate-6 flex-col items-center justify-center gap-1.5 rounded-full border-[1.5px] border-black bg-cream p-2.5 text-center">
            <span class="font-display text-sm uppercase leading-[1.1]">{t('team.stampTop')}</span>
            <span class="h-[1.5px] w-[34px] bg-black"></span>
            <span class="text-[9px] uppercase tracking-[0.14em]">{t('team.stampBottom')}</span>
          </div>
          <span class="whitespace-nowrap bg-black px-3.5 py-[9px] text-[10px] font-semibold uppercase tracking-[0.16em] text-white">{t('team.register')}</span>
        </div>
      </div>
      <dl class="m-0 mt-9 grid grid-cols-2 border-t-[1.5px] border-dashed border-black xs:grid-cols-4">
        {stats.map((s) => (
          <div class:list={['border-black px-4 py-[18px] text-center', s.border]}>
            <dt class="mb-1.5 text-[10px] uppercase tracking-[0.16em] opacity-60">{s.label}</dt>
            <dd class="m-0 font-display text-xl uppercase">{s.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-hidden="true" class="mt-14 border-y-2 border-black">
      <div class="grid h-16 grid-cols-2">
        <div class="bg-[repeating-linear-gradient(-45deg,#000_0_10px,#2b2b2b_10px_20px)]"></div>
        <div class="bg-white"></div>
      </div>
    </section>

    {people.map((p) => {
      // Odd people have the text on the left and the photo on the right, even people the opposite.
      const photoLeft = p.numero % 2 === 0;
      return (
        <section class="border-b-2 border-black">
          <div class="relative grid grid-cols-1 items-stretch split:grid-cols-2">
            <div class:list={['relative order-first aspect-[4/5] overflow-hidden bg-black', photoLeft ? 'split:order-none split:border-r-2 split:border-black' : 'split:order-last']}>
              {p.foto ? (
                <Img src={p.foto} alt={p.name} sizes="(min-width: 860px) 50vw, 100vw" widths={[480, 768, 960, 1280]} class="absolute inset-0 size-full object-cover grayscale" />
              ) : (
                <>
                  <div class="absolute inset-0 bg-[repeating-linear-gradient(45deg,#1a1a1a_0_14px,#000_14px_28px)] grayscale"></div>
                  <div class="absolute inset-0 flex items-center justify-center p-5 text-center text-[11px] uppercase tracking-[0.16em] text-white opacity-75">{t('team.photoPlaceholder')}<br />{p.fotoSlot}</div>
                </>
              )}
              <span class="absolute bottom-3 left-3 border-[1.5px] border-black bg-white px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-[0.08em] text-black">{p.fotoSlot} · {t('team.photoCaption')}</span>
              {!photoLeft && (
                <div class="absolute inset-x-0 top-0 z-[2] flex items-start justify-between p-3">
                  <span class="border-[1.5px] border-black bg-white px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-[0.08em] text-black">{p.technique}</span>
                  <span class="flex size-[34px] shrink-0 items-center justify-center rounded-full border-[1.5px] border-white bg-black text-xs font-bold text-white">#{p.numero}</span>
                </div>
              )}
            </div>

            <div class:list={['flex flex-col gap-[18px] bg-cream px-8 pb-10 pt-14', !photoLeft && 'split:border-r-2 split:border-black']}>
              {photoLeft && (
                <div class="flex items-start justify-between gap-3">
                  <span class="text-[11px] font-semibold uppercase tracking-[0.14em]">{p.technique}</span>
                  <span class="flex size-[34px] shrink-0 items-center justify-center rounded-full border-[1.5px] border-black text-xs font-bold">#{p.numero}</span>
                </div>
              )}
              <div class="relative">
                <span aria-hidden="true" class="pointer-events-none absolute -top-3.5 right-0 font-display text-[clamp(60px,9vw,110px)] leading-none text-transparent opacity-[.16] [-webkit-text-stroke:1.5px_#000]">{String(p.numero).padStart(2, '0')}</span>
                <h2 class="relative m-0 max-w-[80%] font-display text-[clamp(28px,3.6vw,44px)] font-normal uppercase leading-[1.02]">{p.name}</h2>
              </div>
              <div class="border-t-[1.5px] border-dashed border-black"></div>
              <p class="m-0 text-[15px] leading-[1.6] text-pretty">{p.bio}</p>
              <div class="border-[1.5px] border-black">
                <div class="bg-black px-3.5 py-2 text-[10px] uppercase tracking-[0.1em] text-white">{t('team.results')}</div>
                <div class="flex">
                  {[[p.stats[0], p.stat1], [p.stats[1], p.stat2]].map(([valor, texto], i) => (
                    <div class:list={['flex-1 px-[18px] py-4', i === 0 && 'border-r-[1.5px] border-black']}>
                      <div class="font-display text-[32px] leading-none">{valor}</div>
                      <div class="mt-1 text-[10px] uppercase tracking-[0.1em] opacity-65">{texto}</div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <span class="absolute left-4 top-4 z-[3] border-[1.5px] border-black bg-white px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.14em]">{p.label}</span>
          </div>
          <div class="flex items-center justify-between border-t-[1.5px] border-black px-5 py-3 text-[10px] uppercase tracking-[0.16em] opacity-70">
            <span>{p.footLeft}</span>
            <span>{p.footRight}</span>
          </div>
        </section>
      );
    })}

    <section class="bg-black px-5 pb-[70px] pt-[90px] text-center text-white">
      <Chip tone="dark" class="mb-7 -rotate-[1.5deg] px-4 py-[7px]">{t('team.closingChip')}</Chip>
      <h2 class="mx-auto mb-[30px] max-w-[920px] font-display text-[clamp(28px,5vw,58px)] font-normal uppercase leading-[1.08]">{t('team.closingTitle')}</h2>
      <a href={url(lang, 'catalogo')} class="inline-block border-2 border-white bg-white px-7 py-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-black hover:no-underline">{t('team.collection')}</a>
      <div class="mx-auto mt-14 flex max-w-[1180px] flex-wrap justify-between gap-3.5 border-t-[1.5px] border-dashed border-white pt-6 text-[10px] uppercase tracking-[0.16em] opacity-70">
        {closingValues.map((v) => <span>{v}</span>)}
      </div>
    </section>
  </main>
</BaseLayout>
