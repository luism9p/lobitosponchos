---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chip from '../components/Chip.astro';
import Img from '../components/Img.astro';
import Lines from '../components/Lines.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { equipo } from '../data/equipo';
import { workawayUrl } from '../data/site';
import { url, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t, list } = useTranslations(lang);

interface PersonText {
  label: string;
  name: string;
  bio: string;
}
const texts = list<PersonText>('team.people');
const people = equipo.map((p, i) => ({ ...p, ...texts[i] }));

const volunteerFacts = list<{ label: string; value: string }>('team.volunteer.facts');
const volunteerHelp = list('team.volunteer.help');
const closingValues = list('team.values');
---

<BaseLayout
  lang={lang}
  route="equipo"
  title={t('team.seoTitle')}
  description={t('team.seoDescription')}
  variant="solid"
  current="equipo"
>
  <main>
    <section class="mx-auto max-w-[1180px] px-5 pt-[150px]">
      <Chip class="mb-[22px]">{t('team.chip')}</Chip>
      <div class="grid grid-cols-1 items-start gap-6 split:grid-cols-[1.4fr_1fr]">
        <div>
          <h1 class="m-0 mb-5 inline-block border-b-[3px] border-black pb-4 font-display text-[clamp(42px,6.4vw,88px)] font-normal uppercase leading-[.98]"><Lines text={t('team.title')} /></h1>
          <p class="m-0 max-w-[560px] text-[17px] leading-[1.6] text-pretty">{t('team.lead')}</p>
          <div class="mt-6 flex max-w-[560px] flex-col items-start gap-3 border-t-[1.5px] border-black pt-5 xs:flex-row xs:items-center xs:justify-between">
            <p class="m-0 text-[15px] leading-[1.55] text-pretty">{t('team.volunteerTeaser')}</p>
            <a href="#voluntariado" class="shrink-0 border-2 border-black px-4 py-2.5 text-xs font-semibold uppercase tracking-[0.14em] text-black hover:bg-black hover:text-white hover:no-underline">{t('team.volunteerLink')}</a>
          </div>
        </div>
        <div class="flex flex-col items-start gap-3.5 split:items-end">
          <div class="flex size-[150px] -rotate-6 flex-col items-center justify-center gap-1.5 rounded-full border-[1.5px] border-black bg-cream p-2.5 text-center">
            <span class="font-display text-sm uppercase leading-[1.1]">{t('team.stampTop')}</span>
            <span class="h-[1.5px] w-[34px] bg-black"></span>
            <span class="text-[9px] uppercase tracking-[0.14em]">{t('team.stampBottom')}</span>
          </div>
          <span class="whitespace-nowrap bg-black px-3.5 py-[9px] text-[10px] font-semibold uppercase tracking-[0.16em] text-white">{t('team.register')}</span>
        </div>
      </div>
    </section>

    <div aria-hidden="true" class="mt-14 border-b-2 border-black"></div>

    <!-- The five of us, as a compact grid -->
    <section class="border-b-2 border-black px-5 py-16 split:py-20">
      <ul class="mx-auto m-0 grid max-w-[1180px] list-none grid-cols-1 gap-x-8 gap-y-12 p-0 xs:grid-cols-2 split:grid-cols-3">
        {people.map((p) => (
          <li class="flex flex-col gap-3">
            <div class="relative mb-2 aspect-[4/3] overflow-hidden border-2 border-black bg-black">
              {p.foto ? (
                <Img src={p.foto} alt={p.name} sizes="(min-width: 860px) 380px, (min-width: 620px) 50vw, 100vw" widths={[480, 760]} class="absolute inset-0 size-full object-cover" />
              ) : (
                <>
                  <div class="absolute inset-0 bg-[repeating-linear-gradient(45deg,#1a1a1a_0_14px,#000_14px_28px)]"></div>
                  <div class="absolute inset-0 flex items-center justify-center p-5 text-center text-[11px] uppercase tracking-[0.16em] text-white opacity-75">{t('team.photoPlaceholder')}<br />{p.fotoSlot}</div>
                </>
              )}
            </div>
            <span class="text-[11px] font-semibold uppercase tracking-[0.2em] opacity-70">{p.label}</span>
            <h2 class="m-0 font-display text-[clamp(24px,2.4vw,30px)] font-normal uppercase leading-[1.02]">{p.name}</h2>
            <p class="m-0 text-[15px] leading-[1.6] text-pretty">{p.bio}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="voluntariado" class="scroll-mt-[76px] border-b-2 border-black bg-white px-5 pb-20 pt-[88px]">
      <div class="mx-auto max-w-[1180px]">
        <Chip class="mb-[22px]">{t('team.volunteer.chip')}</Chip>
        <div class="grid grid-cols-1 items-end gap-6 split:grid-cols-[1fr_1.1fr] split:gap-14">
          <h2 class="m-0 inline-block self-start border-b-[3px] border-black pb-4 font-display text-[clamp(38px,5.6vw,76px)] font-normal uppercase leading-[.98]"><Lines text={t('team.volunteer.title')} /></h2>
          <p class="m-0 text-lg leading-[1.6] text-pretty">{t('team.volunteer.lead')}</p>
        </div>
        <dl class="m-0 mt-10 grid grid-cols-1 border-[1.5px] border-black xs:grid-cols-3">
          {volunteerFacts.map((f, i) => (
            <div class:list={['border-black px-5 py-[18px]', i > 0 && 'border-t-[1.5px] xs:border-l-[1.5px] xs:border-t-0']}>
              <dt class="mb-1.5 text-[10px] uppercase tracking-[0.16em] opacity-60">{f.label}</dt>
              <dd class="m-0 text-[15px] font-semibold leading-snug">{f.value}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-10 grid grid-cols-1 gap-8 split:grid-cols-2 split:gap-14">
          <div class="flex flex-col gap-3">
            <h3 class="m-0 text-[11px] font-semibold uppercase tracking-[0.3em]">{t('team.volunteer.helpTitle')}</h3>
            <ul class="m-0 flex list-none flex-col p-0">
              {volunteerHelp.map((item) => <li class="border-b-[1.5px] border-dashed border-black py-2.5 text-[15px]">→ {item}</li>)}
            </ul>
          </div>
          <div class="flex flex-col items-start gap-4 border-[1.5px] border-black bg-cream p-6">
            <h3 class="m-0 text-[11px] font-semibold uppercase tracking-[0.3em]">{t('team.volunteer.lifeTitle')}</h3>
            <p class="m-0 text-base leading-[1.65] text-pretty">{t('team.volunteer.life')}</p>
            <div class="mt-2 flex flex-wrap items-center gap-4">
              <a href={workawayUrl} target="_blank" rel="noopener" class="inline-block border-2 border-black bg-black px-6 py-3 text-xs font-semibold uppercase tracking-[0.16em] text-white hover:bg-white hover:text-black hover:no-underline">{t('team.volunteer.apply')}</a>
              <WhatsAppButton variant="outline-white" message={t('wa.volunteer')}>{t('team.volunteer.ask')}</WhatsAppButton>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-black px-5 pb-[70px] pt-[90px] text-center text-white">
      <Chip tone="dark" class="mb-7 -rotate-[1.5deg] px-4 py-[7px]">{t('team.closingChip')}</Chip>
      <h2 class="mx-auto mb-[30px] max-w-[920px] font-display text-[clamp(28px,5vw,58px)] font-normal uppercase leading-[1.08]">{t('team.closingTitle')}</h2>
      <a href={url(lang, 'catalogo')} class="inline-block border-2 border-white bg-white px-7 py-3.5 text-xs font-semibold uppercase tracking-[0.18em] text-black hover:no-underline">{t('team.collection')}</a>
      <div class="mx-auto mt-14 flex max-w-[1180px] flex-wrap justify-between gap-3.5 border-t-[1.5px] border-dashed border-white pt-6 text-[10px] uppercase tracking-[0.16em] opacity-70">
        {closingValues.map((v) => <span>{v}</span>)}
      </div>
    </section>
  </main>
</BaseLayout>
