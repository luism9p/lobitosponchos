---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Chip from '../components/Chip.astro';
import Lines from '../components/Lines.astro';
import ProductCard from '../components/ProductCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { categorias } from '../data/categorias';
import { url, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t } = useTranslations(lang);

const productos = (await getCollection('productos')).sort((a, b) => a.data.orden - b.data.orden);
// Ponchos are shown in three lines (Classics, Light, One of a kind); everything else goes in a last group.
const lineas = ['clasico', 'light', 'unico'] as const;
const grupos = [
  ...lineas.map((id) => ({
    id,
    title: t(`catalog.lines.${id}.title`),
    text: t(`catalog.lines.${id}.text`),
    link: t(`catalog.lines.${id}.link`),
    productos: productos.filter((p) => p.data.categoria === 'ponchos' && (p.data.linea ?? 'clasico') === id),
  })),
  { id: 'otros', title: '', text: '', link: '', productos: productos.filter((p) => p.data.categoria !== 'ponchos') },
].filter((g) => g.productos.length > 0);
const filtros = [{ id: 'todos', nombre: t('catalog.all') }, ...categorias.map((c) => ({ id: c.id, nombre: t(`categories.${c.id}.name`) }))];
const tab =
  'cursor-pointer border-[1.5px] border-black bg-white px-3.5 py-3 text-[11px] font-semibold uppercase tracking-[0.14em] text-black transition-colors hover:bg-black hover:text-white aria-pressed:bg-black aria-pressed:text-white min-h-[44px]';
---

<BaseLayout
  lang={lang}
  route="catalogo"
  title={t('catalog.seoTitle')}
  description={t('catalog.seoDescription')}
  variant="solid"
  current="catalogo"
>
  <main>
    <section class="mx-auto max-w-[1180px] px-5 pt-[150px]">
      <Chip class="mb-[22px]">{t('catalog.chip')}</Chip>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h1 class="m-0 inline-block border-b-[3px] border-black pb-4 font-display text-[clamp(42px,6.4vw,88px)] font-normal uppercase leading-[.98]">
          <Lines text={t('catalog.title')} />
        </h1>
        <div class="flex max-w-[440px] flex-col gap-3">
          <p class="m-0 text-[17px] leading-[1.6] text-pretty">{t('catalog.lead')}</p>
        </div>
      </div>

      <div class="mt-9 flex flex-wrap items-center justify-between gap-4 border-y-[1.5px] border-dashed border-black py-4">
        <div class="flex flex-wrap gap-2" role="group" aria-label={t('catalog.filterLabel')} data-filters>
          {filtros.map((f) => (
            <button type="button" data-filter={f.id} aria-pressed={f.id === 'todos' ? 'true' : 'false'} class={tab}>{f.nombre}</button>
          ))}
        </div>
        <span class="text-[11px] uppercase tracking-[0.16em] opacity-70" aria-live="polite"><span data-count>{productos.length}</span> {t('catalog.products')}</span>
      </div>
    </section>

    <div class="mx-auto flex max-w-[1180px] flex-col gap-16 px-5 pb-24 pt-10">
      {grupos.map((g, gi) => (
        <section data-group id={g.id} class="scroll-mt-[96px]">
          {g.title && (
            <div class="mb-7 flex flex-wrap items-end justify-between gap-x-8 gap-y-4 border-b-2 border-black pb-4">
              <div class="flex max-w-[640px] flex-col gap-2.5">
                <h2 class="m-0 font-display text-[clamp(30px,4.4vw,52px)] font-normal uppercase leading-none">{g.title}</h2>
                <p class="m-0 text-[15px] leading-[1.55] text-pretty">{g.text}</p>
              </div>
              {g.id === 'clasico' && g.link && (
                <a href={url(lang, 'disena')} class="shrink-0 border-b-2 border-black pb-[3px] text-xs font-semibold uppercase tracking-[0.14em] text-black hover:no-underline">{g.link}</a>
              )}
              {g.id === 'unico' && g.link && <WhatsAppButton class="shrink-0" message={t('wa.custom')}>{g.link}</WhatsAppButton>}
            </div>
          )}
          <ul class="m-0 grid grid-cols-2 gap-x-3.5 gap-y-9 p-0 split:grid-cols-3 split:gap-x-6">
            {g.productos.map((producto, i) => <ProductCard lang={lang} producto={producto} eager={gi === 0 && i < 4} />)}
          </ul>
        </section>
      ))}
      <p data-empty hidden class="text-center text-base">{t('catalog.empty')}</p>
    </div>

    <section class="border-y-2 border-black bg-black px-5 py-[70px] text-center text-white">
      <h2 class="mx-auto mb-7 max-w-[820px] font-display text-[clamp(28px,5vw,58px)] font-normal uppercase leading-[1.08]">{t('catalog.ctaTitle')}</h2>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href={url(lang, 'disena')} class="inline-flex rotate-2 items-center border-2 border-white bg-black px-4 pb-[9px] pt-2.5 text-xs font-semibold uppercase tracking-[0.12em] text-white transition-transform duration-200 hover:-rotate-[1.5deg] hover:scale-[1.04] hover:no-underline">{t('catalog.ctaDesign')} →</a>
        <WhatsAppButton variant="outline-white" message={t('wa.custom')}>{t('catalog.ctaBtn')}</WhatsAppButton>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Category filter. Works on top of the full static list, so the catalogue is complete without JS.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-product]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const groups = document.querySelectorAll<HTMLElement>('[data-group]');

  function apply(cat: string): void {
    let visible = 0;
    cards.forEach((card) => {
      const show = cat === 'todos' || card.dataset.cat === cat;
      card.hidden = !show;
      if (show) visible++;
    });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
    groups.forEach((g) => (g.hidden = !g.querySelector('[data-product]:not([hidden])')));
    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible > 0;
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const cat = b.dataset.filter ?? 'todos';
      apply(cat);
      const url = new URL(location.href);
      if (cat === 'todos') url.searchParams.delete('cat');
      else url.searchParams.set('cat', cat);
      history.replaceState(null, '', url);
    }),
  );

  const initial = new URLSearchParams(location.search).get('cat');
  if (initial && [...buttons].some((b) => b.dataset.filter === initial)) apply(initial);
</script>
