---
import type { CollectionEntry } from 'astro:content';
import Img from './Img.astro';
import { localizeProduct } from '../data/products';
import { url, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  producto: CollectionEntry<'productos'>;
  /** The first cards of a list load right away; the rest wait until they are near the viewport. */
  eager?: boolean;
}
const { lang, producto, eager = false } = Astro.props;
const { t } = useTranslations(lang);
const { precio, fotos, categoria } = producto.data;
const { nombre, etiqueta, resumen } = localizeProduct(producto, lang);
const cover = fotos[0];
const precioTexto = precio ? `S/ ${precio.toLocaleString('es-PE')}` : t('product.priceOnRequest');
---

<li data-product data-cat={categoria} class="list-none">
  <a href={url(lang, 'catalogo', producto.id)} class="group block text-black hover:no-underline">
    <div class="relative aspect-[4/5] overflow-hidden border-2 border-black bg-black">
      <Img
        src={cover.src}
        alt={`${nombre}, ${t('product.photo', { n: 1 })}`}
        sizes="(min-width: 1180px) 380px, (min-width: 860px) 33vw, 50vw"
        widths={[320, 480, 640, 760]}
        eager={eager}
        class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.05]"
      />
      {etiqueta && (
        <span class="absolute left-0 top-0 bg-black px-2.5 py-1.5 text-[10px] uppercase tracking-[0.2em] text-white">{etiqueta}</span>
      )}
    </div>
    <div class="flex flex-col gap-1 pt-3">
      <div class="flex flex-col gap-0.5 xs:flex-row xs:items-baseline xs:justify-between xs:gap-3">
        <h3 class="m-0 font-display text-[clamp(20px,2.4vw,28px)] font-normal uppercase leading-none group-hover:underline">{nombre}</h3>
        <span class="shrink-0 text-[13px] font-semibold uppercase tracking-[0.06em] xs:text-right">{precioTexto}</span>
      </div>
      <p class="m-0 hidden text-sm leading-snug opacity-70 xs:block">{resumen}</p>
    </div>
  </a>
</li>
