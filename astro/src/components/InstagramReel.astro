---
// The Instagram reel shown on its own in the home "Life in Lobitos" section.
// It is a saved clip, not a live feed, so it is labelled "From our Instagram".
// The video is muted, loops, and only starts downloading when it gets close to the viewport.
import { getImage } from 'astro:assets';
import poster from '../assets/historias/reel-poster.png';
import { instagramUrl } from '../data/site';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t } = useTranslations(lang);

const posterImage = await getImage({ src: poster, width: 540, format: 'webp', quality: 70 });
---

<figure class="relative m-0 aspect-[4/5] w-full max-w-[400px] overflow-hidden border-2 border-black bg-cream">
  <a href={instagramUrl} target="_blank" rel="noopener" aria-label={t('instagram.ariaLabel')} class="absolute inset-0 block hover:no-underline">
    <video
      data-lazy-video
      muted
      loop
      playsinline
      preload="none"
      poster={posterImage.src}
      width="540"
      height="675"
      aria-label={t('instagram.videoLabel')}
      class="absolute inset-0 size-full object-cover"
    >
      <source data-src="/media/reel.webm" type="video/webm" />
      <source data-src="/media/reel.mp4" type="video/mp4" />
    </video>
    <figcaption class="absolute left-3.5 top-3.5 border-[1.5px] border-black bg-white px-3 py-[7px] text-[11px] font-semibold uppercase tracking-[0.1em] text-black">{t('home.lifeFeedLabel')} ↗</figcaption>
  </a>
</figure>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]');
  const start = (video: HTMLVideoElement) => {
    video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => {
      s.src = s.dataset.src!;
    });
    video.load();
    video.play().catch(() => {});
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          start(entry.target as HTMLVideoElement);
          io.unobserve(entry.target);
        });
      },
      { rootMargin: '300px' },
    );
    videos.forEach((v) => io.observe(v));
  } else {
    videos.forEach(start);
  }
</script>
