---
import logo from '../assets/brand/logo.png';
import Img from './Img.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { categorias, catalogoUrl } from '../data/categorias';
import { instagramUrl, whatsappUrl } from '../data/site';
import { url, useTranslations, englishLive, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** `overlay` floats transparent over the home hero (and turns white once you scroll); `solid` is the white bar of inner pages. */
  variant?: 'overlay' | 'solid';
  current?: 'inicio' | 'catalogo' | 'causa' | 'equipo' | 'historia' | 'b2b' | 'contacto';
  /** URL of this same page in each language (for the ES | EN switcher). */
  alternates?: Record<Lang, string>;
}
const { lang, variant = 'overlay', current, alternates } = Astro.props;
const { t } = useTranslations(lang);
const solid = variant === 'solid';
const showSwitcher = englishLive && !!alternates;

const home = url(lang, 'home');
// The three poncho lines (sections of the catalogue page), listed under Ponchos in the shop menus.
const ponchoLines = (['clasico', 'light', 'unico'] as const).map((id) => ({
  href: url(lang, 'catalogo', undefined, id),
  label: t(`catalog.lines.${id}.title`),
}));
const volunteerHref = url(lang, 'equipo', undefined, 'voluntariado');
const subRow =
  'flex items-baseline justify-between border-b-[1.5px] border-black py-3 pl-4 text-sm font-semibold uppercase tracking-[0.14em] text-black hover:no-underline';
const catName = (id: string) => t(`categories.${id}.name`);

const navLink =
  'underline-offset-[6px] decoration-[1.5px] hover:underline data-[current]:underline';
const megaRow =
  'group/item flex items-baseline justify-between gap-4 border-b-[1.5px] border-black py-3.5 font-display text-[clamp(26px,2.6vw,40px)] uppercase leading-none text-black transition-[padding] duration-200 hover:no-underline data-[active]:bg-black data-[active]:px-3.5 data-[active]:text-white';
const aboutRow =
  'flex w-full items-baseline justify-between gap-4 border-b-[1.5px] border-black py-3 font-display text-[clamp(24px,2.2vw,34px)] uppercase leading-none text-black transition-[padding,background] duration-150 hover:bg-black hover:px-3.5 hover:text-white hover:no-underline';
const mobileRow =
  'flex items-baseline justify-between border-b-[1.5px] border-black py-3.5 font-display text-2xl uppercase leading-none text-black hover:no-underline';
const mobileTop =
  'block border-b-[1.5px] border-black py-3.5 font-display text-[28px] uppercase leading-none text-black hover:no-underline';
// On phones the language switch is one button showing the other language.
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
// Phone buttons in the bar (language, WhatsApp, menu): identical outlined squares.
const phoneBtn = 'flex size-10 shrink-0 items-center justify-center border-[1.5px] border-current hover:no-underline nav:hidden';
const langLink = 'px-1 hover:underline aria-[current=true]:font-bold aria-[current=true]:underline underline-offset-[6px]';
---

<header
  data-header
  data-menu=""
  class:list={[
    'group/header fixed inset-x-0 top-0 z-50 data-[dark]:text-black',
    // On phones the home header is a plain white bar too, so the photo below has no dark band.
    solid ? 'text-black' : 'text-black nav:text-white',
  ]}
>
  <div
    class:list={[
      'relative z-[2] flex items-center justify-between gap-4 px-[18px] py-3 nav:py-3.5',
      solid
        ? 'border-b border-black bg-white nav:border-b-2'
        : 'border-b border-black bg-white transition-colors duration-300 nav:border-b-2 nav:border-transparent nav:bg-transparent nav:group-data-[scrolled]/header:border-black nav:group-data-[scrolled]/header:bg-white',
    ]}
  >
    <a href={home} aria-label={t('nav.homeAria')} class="flex shrink-0 items-center">
      <Img
        src={logo}
        alt="Lobitos Ponchos"
        sizes="(min-width: 1000px) 46px, 52px"
        widths={[52, 104, 156]}
        eager
        class:list={[
          'block size-[52px] rounded-full border-[1.5px] nav:size-[46px] group-data-[dark]/header:border-black',
          solid ? 'border-black' : 'border-black nav:border-white',
        ]}
      />
    </a>

    <nav class="hidden items-center gap-7 text-[13px] uppercase tracking-[0.14em] nav:flex" aria-label={t('nav.main')}>
      <a href={home} class={navLink} data-current={current === 'inicio' ? '' : undefined} data-close-menus>{t('nav.home')}</a>
      <button
        type="button"
        data-trigger="mega"
        aria-expanded="false"
        class="flex cursor-pointer items-center gap-1.5 uppercase underline-offset-[6px] decoration-[1.5px] group-data-[menu=mega]/header:underline"
      >
        <span>{t('nav.shop')}</span>
        <span class="inline-block text-[10px] transition-transform duration-[250ms] group-data-[menu=mega]/header:rotate-180">▼</span>
      </button>
      <button
        type="button"
        data-trigger="about"
        aria-expanded="false"
        class="flex cursor-pointer items-center gap-1.5 uppercase underline-offset-[6px] decoration-[1.5px] group-data-[menu=about]/header:underline"
      >
        <span>{t('nav.about')}</span>
        <span class="inline-block text-[10px] transition-transform duration-[250ms] group-data-[menu=about]/header:rotate-180">▼</span>
      </button>
      <a href={url(lang, 'b2b')} class={navLink} data-current={current === 'b2b' ? '' : undefined} data-close-menus>{t('nav.b2b')}</a>
      <a href={url(lang, 'contacto')} class={navLink} data-current={current === 'contacto' ? '' : undefined} data-close-menus>{t('nav.contact')}</a>
    </nav>

    <div class="flex shrink-0 items-center gap-2.5">
      {showSwitcher && (
        <div class="hidden items-center text-xs uppercase tracking-[0.14em] nav:flex" role="group" aria-label={t('nav.language')}>
          <a href={alternates?.es} hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined} class={langLink}>ES</a>
          <span aria-hidden="true">|</span>
          <a href={alternates?.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined} class={langLink}>EN</a>
        </div>
      )}
      {showSwitcher && (
        <a href={alternates?.[otherLang]} hreflang={otherLang} lang={otherLang} aria-label={otherLang === 'en' ? 'English' : 'Español'} class={phoneBtn + ' text-xs font-semibold uppercase tracking-[0.08em]'}>{otherLang}</a>
      )}
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener"
        aria-label={t('nav.whatsapp')}
        class={phoneBtn}
      >
        <WhatsAppIcon />
      </a>
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener"
        class:list={[
          'hidden nav:flex items-center gap-2 border-2 border-black py-2 pl-3 pr-3.5 text-xs font-semibold uppercase tracking-[0.12em] hover:no-underline',
          solid ? 'bg-black text-white' : 'bg-white text-black',
        ]}
      >
        <WhatsAppIcon />
        <span>{t('nav.whatsapp')}</span>
      </a>
      <button
        type="button"
        data-burger
        aria-label={t('nav.menu')}
        aria-expanded="false"
        class="flex size-10 shrink-0 cursor-pointer flex-col justify-center gap-[5px] border-[1.5px] border-current px-[9px] nav:hidden"
      >
        <span class="block h-0.5 bg-current transition-transform duration-[250ms] group-data-[menu=mobile]/header:translate-y-[7px] group-data-[menu=mobile]/header:rotate-45"></span>
        <span class="block h-0.5 bg-current transition-transform duration-[250ms] group-data-[menu=mobile]/header:scale-x-0"></span>
        <span class="block h-0.5 bg-current transition-transform duration-[250ms] group-data-[menu=mobile]/header:-translate-y-[7px] group-data-[menu=mobile]/header:-rotate-45"></span>
      </button>
    </div>
  </div>

  <!-- Desktop: shop mega menu -->
  <div
    data-panel="mega"
    class="absolute inset-x-0 top-0 z-[1] hidden border-b-2 border-black bg-white pt-[74px] text-black nav:data-[open]:block"
  >
    <div class="mx-auto grid max-w-[1180px] grid-cols-[1.1fr_.9fr] items-start gap-14 px-8 pb-10 pt-7">
      <div class="flex flex-col">
        <div class="mb-2.5 text-[11px] uppercase tracking-[0.34em] opacity-60">{t('nav.shopCategories')}</div>
        {categorias.map((cat, i) => (
          <Fragment>
          <a
            href={catalogoUrl(lang, cat.id)}
            class={megaRow}
            data-megaitem={i}
            data-name={catName(cat.id)}
            data-active={i === 0 ? '' : undefined}
          >
            <span class="flex items-baseline gap-3.5">
              <span class="font-sans text-[11px] tracking-[0.3em] opacity-60">{String(i + 1).padStart(2, '0')}</span>
              <span>{catName(cat.id)}</span>
            </span>
            <span class="font-sans text-xl opacity-0 transition-opacity duration-200 group-data-[active]/item:opacity-100">→</span>
          </a>
          {cat.id === 'ponchos' && (
            <ul class="m-0 list-none border-b-[1.5px] border-black p-0 py-1.5">
              {ponchoLines.map((l) => (
                <li>
                  <a href={l.href} data-megasub={i} class="group/sub flex items-center justify-between py-2.5 pl-[38px] pr-3.5 text-[13px] font-semibold uppercase tracking-[0.16em] text-black/65 transition-colors hover:bg-black hover:text-white hover:no-underline focus-visible:bg-black focus-visible:text-white">
                    <span class="flex items-center gap-3"><span aria-hidden="true" class="h-[1.5px] w-4 bg-current"></span>{l.label}</span>
                    <span aria-hidden="true" class="font-sans text-base opacity-0 transition-opacity group-hover/sub:opacity-100 group-focus-visible/sub:opacity-100">→</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          </Fragment>
        ))}
        <a href={url(lang, 'disena')} class={aboutRow} data-megaclear>
          <span class="flex items-baseline gap-3.5"><span class="font-sans text-[11px] tracking-[0.3em] opacity-60">{String(categorias.length + 1).padStart(2, '0')}</span><span>{t('nav.design')}</span></span>
          <span class="font-sans text-xl">→</span>
        </a>
      </div>
      <div class="flex flex-col items-start gap-4">
        <div class="relative aspect-[5/4] w-full overflow-hidden border-2 border-black bg-black">
          {categorias.map((cat, i) => (
            <div data-megaimg={i} data-active={i === 0 ? '' : undefined} class="absolute inset-0 opacity-0 transition-opacity duration-[250ms] data-[active]:opacity-100">
              <Img src={cat.imagen} alt="" sizes="(min-width: 1180px) 520px, 45vw" widths={[320, 520, 780]} class="size-full object-cover" />
            </div>
          ))}
          <span data-megatag class="absolute left-0 top-0 bg-black px-2.5 py-1.5 text-[10px] uppercase tracking-[0.24em] text-white">{catName(categorias[0].id)}</span>
        </div>
        <a href={catalogoUrl(lang)} class="border-b-2 border-black pb-[3px] text-xs uppercase tracking-[0.14em]">{t('nav.viewCollection')}</a>
      </div>
    </div>
  </div>

  <!-- Desktop: about menu -->
  <div
    data-panel="about"
    class="absolute inset-x-0 top-0 z-[1] hidden border-b-2 border-black bg-white pt-[74px] text-black nav:data-[open]:block"
  >
    <div class="mx-auto flex max-w-[520px] flex-col items-start px-8 pb-[34px] pt-6">
      <div class="mb-2.5 text-[11px] uppercase tracking-[0.34em] opacity-60">{t('nav.about')}</div>
      <a href={url(lang, 'historia')} class={aboutRow}>
        <span>{t('nav.history')}</span>
        <span class="font-sans text-lg">→</span>
      </a>
      <a href={url(lang, 'causa')} class={aboutRow}>
        <span>{t('nav.cause')}</span>
        <span class="font-sans text-lg">→</span>
      </a>
      <a href={url(lang, 'equipo')} class={aboutRow}>
        <span>{t('nav.team')}</span>
        <span class="font-sans text-lg">→</span>
      </a>
      <a href={volunteerHref} class={aboutRow}>
        <span>{t('footer.volunteer')}</span>
        <span class="font-sans text-lg">→</span>
      </a>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    data-panel="mobile"
    class="absolute inset-x-0 top-0 z-[1] hidden h-svh flex-col overflow-y-auto bg-white px-5 pb-10 pt-[90px] text-black data-[open]:flex nav:hidden! [height:100dvh]"
  >
    <a href={home} class={mobileTop}>{t('nav.home')}</a>
    <details class="group/acc">
      <summary class="flex cursor-pointer list-none items-center justify-between border-b-[1.5px] border-black py-3.5 font-display text-[28px] uppercase leading-none [&::-webkit-details-marker]:hidden">
        <span>{t('nav.shop')}</span>
        <span class="font-sans text-xl group-open/acc:hidden">+</span>
        <span class="hidden font-sans text-xl group-open/acc:inline">–</span>
      </summary>
      <div class="flex flex-col pl-3.5">
        {categorias.map((cat) => (
          <Fragment>
            <a href={catalogoUrl(lang, cat.id)} class={mobileRow}><span>{catName(cat.id)}</span><span class="font-sans text-lg">→</span></a>
            {cat.id === 'ponchos' && ponchoLines.map((l) => <a href={l.href} class={subRow}><span>{l.label}</span><span class="font-sans">→</span></a>)}
          </Fragment>
        ))}
        <a href={url(lang, 'disena')} class={mobileRow}><span>{t('nav.design')}</span><span class="font-sans text-lg">→</span></a>
      </div>
    </details>
    <details class="group/acc">
      <summary class="flex cursor-pointer list-none items-center justify-between border-b-[1.5px] border-black py-3.5 font-display text-[28px] uppercase leading-none [&::-webkit-details-marker]:hidden">
        <span>{t('nav.about')}</span>
        <span class="font-sans text-xl group-open/acc:hidden">+</span>
        <span class="hidden font-sans text-xl group-open/acc:inline">–</span>
      </summary>
      <div class="flex flex-col pl-3.5">
        <a href={url(lang, 'historia')} class={mobileRow}><span>{t('nav.history')}</span><span class="font-sans text-lg">→</span></a>
        <a href={url(lang, 'causa')} class={mobileRow}><span>{t('nav.cause')}</span><span class="font-sans text-lg">→</span></a>
        <a href={url(lang, 'equipo')} class={mobileRow}><span>{t('nav.team')}</span><span class="font-sans text-lg">→</span></a>
        <a href={volunteerHref} class={mobileRow}><span>{t('footer.volunteer')}</span><span class="font-sans text-lg">→</span></a>
      </div>
    </details>
    <a href={url(lang, 'b2b')} class={mobileTop}>{t('nav.b2b')}</a>
    <a href={url(lang, 'contacto')} class={mobileTop}>{t('nav.contact')}</a>
    <div class="mt-9 flex flex-col gap-1 text-[13px] uppercase tracking-[0.14em]">
      <a href={instagramUrl} target="_blank" rel="noopener" class="block py-3 text-black">{t('nav.instagram')}</a>
      {showSwitcher && (
        <div class="flex items-center gap-2 py-2">
          <a href={alternates?.es} hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined} class={langLink + ' text-black'}>ES</a>
          <span aria-hidden="true">|</span>
          <a href={alternates?.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined} class={langLink + ' text-black'}>EN</a>
        </div>
      )}
    </div>
    <div class="mt-auto shrink-0 origin-bottom-left -rotate-2 pt-8 font-display text-[44px] uppercase leading-[.9]">Lobitos<br />Ponchos</div>
  </div>
</header>

<script>
  import { initHeader } from '../scripts/header';
  initHeader();
</script>
