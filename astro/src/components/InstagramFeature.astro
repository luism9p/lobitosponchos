---
import { getImage } from 'astro:assets';
import poster from '../assets/historias/reel-poster.png';
import { instagramUrl, site } from '../data/site';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Hide the big "Follow us" heading when the section already has its own (home page). */
  heading?: boolean;
}
const { lang, heading = true } = Astro.props;
const { t } = useTranslations(lang);

// The old 13 MB gif is now a ~0.7 MB muted looping video that only starts downloading
// when it gets close to the viewport.
const posterImage = await getImage({ src: poster, width: 540, format: 'webp', quality: 70 });
---

<section id="instagram" class:list={['flex flex-col items-center gap-10 overflow-x-hidden bg-white px-5 pb-[90px] text-black', heading ? 'pt-20' : 'pt-14']}>
  {heading && (
    <div class="flex flex-col items-center gap-3 text-center">
      <span class="border-[1.5px] border-black bg-white px-3.5 py-1.5 text-[10px] font-semibold uppercase tracking-[0.2em]">{t('instagram.label')}</span>
      <h2 class="font-display text-[clamp(48px,10vw,110px)] font-normal uppercase leading-[.9]">{t('instagram.title')}</h2>
      <span class="text-xs uppercase tracking-[0.3em] opacity-70">{site.instagramHandle}</span>
    </div>
  )}

  <a
    href={instagramUrl}
    target="_blank"
    rel="noopener"
    aria-label={t('instagram.ariaLabel')}
    class="group/ig block w-full max-w-[920px] border-2 border-black bg-cream text-black shadow-[6px_6px_0_#000] hover:no-underline xs:shadow-[10px_10px_0_#000]"
  >
    <div class="flex flex-wrap items-center justify-between gap-3.5 px-6 py-5">
      <div class="flex items-center gap-3.5">
        <div class="flex size-[46px] shrink-0 items-center justify-center rounded-full bg-black font-display text-[15px] text-white">LP</div>
        <div class="flex flex-col gap-0.5">
          <span class="text-[13px] font-bold uppercase tracking-[0.1em]">{site.name}</span>
          <span class="text-[11px] uppercase tracking-[0.08em] text-[#666]">{t('instagram.location')}</span>
        </div>
      </div>
      <span class="whitespace-nowrap border-b-[1.5px] border-black pb-0.5 text-[11px] font-semibold uppercase tracking-[0.16em]">{t('instagram.viewFeed')}</span>
    </div>
    <div class="border-t-[1.5px] border-dashed border-black"></div>
    <div class="grid grid-cols-1 md:grid-cols-[1.1fr_1fr]">
      <div class="relative aspect-[4/5] overflow-hidden border-b-[1.5px] border-dashed border-black bg-cream md:aspect-auto md:h-full md:border-b-0 md:border-r-[1.5px]">
        <video
          data-lazy-video
          muted
          loop
          playsinline
          preload="none"
          poster={posterImage.src}
          width="540"
          height="675"
          aria-label={t('instagram.videoLabel')}
          class="absolute inset-0 size-full object-contain grayscale contrast-110 transition-[filter] duration-300 group-hover/ig:grayscale-0"
        >
          <source data-src="/media/reel.webm" type="video/webm" />
          <source data-src="/media/reel.mp4" type="video/mp4" />
        </video>
        <span class="absolute bottom-3 left-3 border-[1.5px] border-black bg-white px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-[0.1em]">{t('instagram.postLabel')}</span>
      </div>
      <div class="flex flex-col gap-3.5 px-6 py-[26px]">
        <span class="font-display text-[clamp(36px,5vw,52px)] leading-none">12.4K</span>
        <span class="-mt-2 text-[11px] uppercase tracking-[0.2em] opacity-70">{t('instagram.audience')}</span>
        <p class="m-0 text-[15px] leading-[1.55] text-pretty">{t('instagram.text')}</p>
        <div class="mt-1 border-t-[1.5px] border-dashed border-black pt-3.5">
          <span class="border-b-[1.5px] border-black pb-0.5 text-[11px] font-semibold uppercase tracking-[0.16em]">{t('instagram.connect')}</span>
        </div>
      </div>
    </div>
  </a>

  <div class="relative mt-3.5 h-1 w-full max-w-[920px] bg-black">
    <a
      href={instagramUrl}
      target="_blank"
      rel="noopener"
      class="absolute -top-4 right-0 -rotate-2 border-[1.5px] border-black bg-white px-3.5 py-[7px] text-[10px] font-semibold uppercase tracking-[0.14em] text-black hover:no-underline"
    >{t('instagram.follow', { handle: site.instagramHandle })}</a>
  </div>
</section>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]');
  const start = (video: HTMLVideoElement) => {
    video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => {
      s.src = s.dataset.src!;
    });
    video.load();
    video.play().catch(() => {});
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          start(entry.target as HTMLVideoElement);
          io.unobserve(entry.target);
        });
      },
      { rootMargin: '300px' },
    );
    videos.forEach((v) => io.observe(v));
  } else {
    videos.forEach(start);
  }
</script>
