---
// Responsive picture: AVIF + WebP at several widths, with explicit dimensions so the
// page never jumps while images load. Everything below the fold is lazy by default.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** `sizes` attribute: tell the browser how wide the image renders at each breakpoint. */
  sizes: string;
  widths?: number[];
  /** Above-the-fold image: load immediately and with high priority. */
  eager?: boolean;
  quality?: number;
  class?: string;
  pictureClass?: string;
  position?: string;
}

const {
  src,
  alt,
  sizes,
  widths = [320, 480, 640, 768, 960, 1280, 1600, 1920, 2560],
  eager = false,
  quality = 82,
  class: className,
  pictureClass,
  position,
} = Astro.props;

// Never ask for a width larger than the source file. If a requested width is bigger
// than the source, use the full source width instead, so sharp screens get every pixel.
const usable = widths.filter((w) => w <= src.width);
const finalWidths = usable.length < widths.length ? [...new Set([...usable, src.width])] : usable;
---

<Picture
  src={src}
  alt={alt}
  widths={finalWidths}
  sizes={sizes}
  formats={['avif']}
  fallbackFormat="webp"
  quality={quality}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : 'auto'}
  class={className}
  pictureAttributes={{ class: pictureClass ?? 'contents' }}
  style={position ? `object-position:${position}` : undefined}
/>
