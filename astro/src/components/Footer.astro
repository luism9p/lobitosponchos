---
import LogoBadge from './LogoBadge.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { catalogoUrl } from '../data/categorias';
import { instagramUrl, site, whatsappUrl } from '../data/site';
import { url, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Home page: "Let's talk", the WhatsApp button and the big logo above the links. Other pages get a compact footer. */
  full?: boolean;
  /** Small logo at the start of the compact footer. Off on pages whose last black section already shows the logo. */
  logo?: boolean;
}
const { lang, full = false, logo = true } = Astro.props;
const { t } = useTranslations(lang);

const groups = [
  {
    title: t('footer.shop'),
    links: [
      { href: catalogoUrl(lang), label: t('footer.ponchos') },
      { href: url(lang, 'disena'), label: t('footer.design') },
      { href: whatsappUrl(t('wa.custom')), label: t('footer.custom'), external: true },
      { href: url(lang, 'b2b'), label: t('footer.b2b') },
    ],
  },
  {
    title: t('footer.about'),
    links: [
      { href: url(lang, 'historia'), label: t('footer.story') },
      { href: url(lang, 'causa'), label: t('nav.cause') },
      { href: url(lang, 'equipo'), label: t('footer.team') },
      { href: url(lang, 'equipo', undefined, 'voluntariado'), label: t('footer.volunteer') },
    ],
  },
  {
    title: t('footer.contact'),
    links: [
      { href: whatsappUrl(), label: `WhatsApp ${site.whatsappLabel}`, external: true },
      { href: instagramUrl, label: `Instagram ${site.instagramHandle}`, external: true },
      { href: `mailto:${site.email}`, label: site.email },
      { href: url(lang, 'contacto'), label: t('footer.contactPage') },
    ],
  },
];
const link = 'text-white/80 hover:text-white hover:underline underline-offset-4';
---

<footer id="contacto" class:list={['bg-black px-5 text-white', full ? 'border-t-2 border-black pb-12 pt-14 split:pb-14 split:pt-16' : 'border-t border-white/20 py-10']}>
  <div class:list={['mx-auto flex max-w-[1180px] flex-col', full ? 'gap-12 split:flex-row split:items-center split:justify-between split:gap-16' : 'gap-8 split:flex-row split:items-start split:gap-14']}>
    {full && (
      <LogoBadge size={340} class="order-last w-[min(62vw,260px)] self-center split:w-[clamp(240px,26vw,340px)] split:self-auto" />
    )}
    {!full && logo && <LogoBadge size={88} class="w-[72px] shrink-0 split:w-[88px]" />}

    <div class:list={['flex min-w-0 flex-1 flex-col', full && 'gap-12']}>
      {full && (
        <div class="flex flex-col items-start gap-7 border-b border-white/20 pb-12">
          <h2 class="m-0 font-display text-[clamp(52px,8vw,100px)] font-normal uppercase leading-[.85]">{t('footer.talk')}</h2>
          <a
            href={whatsappUrl()}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-[44px] items-center gap-2.5 border-2 border-white bg-white px-6 py-3 text-xs font-semibold uppercase tracking-[0.16em] text-black hover:bg-black hover:text-white hover:no-underline"
          >
            <WhatsAppIcon size={16} />
            <span>{t('footer.orderBtn')}</span>
          </a>
        </div>
      )}

      <nav aria-label={t('nav.main')} class="grid grid-cols-2 gap-x-8 gap-y-8 text-sm md:grid-cols-3">
        {groups.map((g) => (
          <div class="flex flex-col gap-2 [&:nth-child(3)]:col-span-2 md:[&:nth-child(3)]:col-span-1">
            <span class="mb-1 text-[11px] uppercase tracking-[0.2em] text-white/55">{g.title}</span>
            {g.links.map((l) => (
              <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined} class={link}>{l.label}</a>
            ))}
          </div>
        ))}
      </nav>
    </div>
  </div>
</footer>
