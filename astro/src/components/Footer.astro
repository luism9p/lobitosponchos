---
import logo from '../assets/brand/logo.png';
import Img from './Img.astro';
import { catalogoUrl } from '../data/categorias';
import { instagramUrl, site, whatsappUrl } from '../data/site';
import { url, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t } = useTranslations(lang);

// A slim footer: the brand, then the links in the same three groups as the top menu.
const groups = [
  {
    title: t('nav.shop'),
    links: [
      { href: catalogoUrl(lang), label: t('footer.collection') },
      { href: url(lang, 'disena'), label: t('nav.design') },
      { href: url(lang, 'b2b'), label: t('nav.b2b') },
    ],
  },
  {
    title: t('nav.about'),
    links: [
      { href: url(lang, 'historia'), label: t('nav.history') },
      { href: url(lang, 'causa'), label: t('nav.cause') },
      { href: url(lang, 'equipo'), label: t('nav.team') },
      { href: url(lang, 'equipo', undefined, 'voluntariado'), label: t('footer.volunteer') },
    ],
  },
  {
    title: t('footer.contactTitle'),
    links: [
      { href: whatsappUrl(), label: `WhatsApp ${site.whatsappLabel}`, external: true },
      { href: instagramUrl, label: `Instagram ${site.instagramHandle}`, external: true },
      { href: `mailto:${site.email}`, label: site.email },
      { href: url(lang, 'contacto'), label: t('footer.contactPage') },
    ],
  },
];
const link = 'text-white hover:underline underline-offset-4';
---

<footer class="border-t-2 border-black bg-black px-5 pb-8 pt-10 text-white">
  <div class="mx-auto flex max-w-[1180px] flex-col gap-9 split:flex-row split:items-start split:justify-between split:gap-12">
    <a href={url(lang, 'home')} class="flex shrink-0 items-center gap-3.5 text-white hover:no-underline">
      <Img src={logo} alt="" sizes="52px" widths={[52, 104, 156]} class="block size-[52px] rounded-full border-[1.5px] border-white" />
      <span class="flex flex-col gap-1">
        <span class="font-display text-2xl uppercase leading-none">{site.name}</span>
        <span class="text-[11px] uppercase tracking-[0.18em] opacity-70">{t('footer.madeIn')}</span>
      </span>
    </a>

    <nav aria-label={t('nav.main')} class="grid grid-cols-2 gap-x-8 gap-y-8 text-sm xs:grid-cols-3 split:gap-x-14">
      {groups.map((g) => (
        <div class="flex flex-col gap-2.5 last:col-span-2 xs:last:col-span-1">
          <span class="mb-0.5 text-[11px] uppercase tracking-[0.2em] opacity-60">{g.title}</span>
          {g.links.map((l) => (
            <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined} class={link}>{l.label}</a>
          ))}
        </div>
      ))}
    </nav>
  </div>

  <div class="mx-auto mt-8 flex max-w-[1180px] flex-wrap justify-between gap-2 border-t border-white/25 pt-5 text-[11px] uppercase tracking-[0.16em] opacity-60">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span>{t('footer.place').replace('\n', ' ')} · {t('footer.country')}</span>
  </div>
</footer>
