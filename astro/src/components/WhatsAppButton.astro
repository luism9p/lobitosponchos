---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappUrl } from '../data/site';

// Button that opens a WhatsApp chat, optionally with the message pre-written.
// Same straight style as the site's other buttons: `solid` is black, `outline-white` is white
// with a black border (for black or coloured backgrounds).
interface Props {
  message?: string;
  variant?: 'solid' | 'outline-white';
  class?: string;
}
const { message, variant = 'solid', class: className } = Astro.props;
const variants = {
  solid: 'border-black bg-black text-white hover:bg-[#222]',
  'outline-white': 'border-black bg-white text-black hover:bg-black hover:text-white',
};
---

<a
  href={whatsappUrl(message)}
  target="_blank"
  rel="noopener"
  class:list={[
    'inline-flex min-h-[44px] items-center justify-center gap-2.5 border-2 px-[26px] py-3.5 text-xs font-semibold uppercase tracking-[0.16em] hover:no-underline',
    variants[variant],
    className,
  ]}
>
  <WhatsAppIcon />
  <span><slot>Escríbenos</slot></span>
</a>
