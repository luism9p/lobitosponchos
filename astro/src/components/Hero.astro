---
import Img from './Img.astro';
import carr1 from '../assets/hero/carr1.webp';
import carr2 from '../assets/hero/carr2.webp';
import carr3 from '../assets/hero/carr3.webp';

import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Seconds each slide stays on screen. */
  autoplay?: number;
}
const { lang, autoplay = 4 } = Astro.props;
const { t, list } = useTranslations(lang);
const alts = list('hero.slides');

// The photos are wide panoramas. Phones only show a slice (about half the width; the height follows the screen width so
// every phone sees the same slice), so each one is framed on its main subject and, for photos 1 and 3, the words
// drawn into them; on desktop the framing keeps the drawn-in words in view.
// `alt` is the index of the photo's description in `hero.slides`.
const slides = [
  { src: carr1, alt: 0, framing: 'object-[33%_50%] nav:object-[35%_50%]' }, // words + boy holding the puppy
  { src: carr3, alt: 2, framing: 'object-[38%_50%] nav:object-[65%_50%]' }, // the surfer
  { src: carr2, alt: 1, framing: 'object-[100%_50%] nav:object-center' }, // words, church and a grandmother
].map((s) => ({ ...s, alt: alts[s.alt] }));
---

<section
  id="top"
  data-carousel
  data-autoplay={autoplay}
  aria-roledescription={t('hero.carousel')}
  aria-label="Lobitos Ponchos"
  class="relative flex w-full touch-pan-y flex-col overflow-hidden bg-white pt-[77px] nav:block nav:h-[650px] nav:bg-black nav:pt-0"
>
  <div class="relative h-[min(75vw,320px)] w-full nav:absolute nav:inset-0 nav:h-auto">
  {slides.map((slide, i) => (
    <div
      data-slide
      data-active={i === 0 ? '' : undefined}
      aria-hidden={i === 0 ? 'false' : 'true'}
      class="absolute inset-0 opacity-0 transition-opacity duration-[900ms] data-[active]:opacity-100"
    >
      <Img
        src={slide.src}
        alt={slide.alt}
        sizes="100vw"
        widths={[480, 768, 1280, 1920, 2560, 3200]}
        eager={i === 0}
        quality={80}
        class:list={['size-full object-cover', slide.framing]}
      />
    </div>
  ))}
  </div>
  <div class="pointer-events-none absolute inset-0 hidden bg-[linear-gradient(180deg,rgba(0,0,0,.6)_0%,rgba(0,0,0,0)_32%,rgba(0,0,0,0)_55%,rgba(0,0,0,.55)_100%)] nav:block"></div>

  <div class="relative flex flex-col items-center gap-1 px-[18px] pt-3 nav:absolute nav:inset-x-0 nav:bottom-[18px] nav:gap-3.5 nav:p-0 nav:px-[18px]">
    <div class="text-center text-black nav:text-white">
      <h1 class="font-display text-[clamp(28px,6vw,56px)] font-normal leading-[.95] tracking-[0.02em]">LOBITOS PONCHOS</h1>
      <p class="mt-1.5 text-[10px] uppercase tracking-[0.34em] opacity-90">{t('hero.tagline')}</p>
    </div>
    <div class="flex items-center gap-2.5">
      {slides.map((_, i) => (
        <button
          type="button"
          data-dot
          data-active={i === 0 ? '' : undefined}
          aria-label={t('hero.goTo', { n: i + 1 })}
          class="box-content h-[3px] w-[34px] cursor-pointer border-0 bg-black bg-clip-content px-1 py-2.5 opacity-35 nav:bg-white nav:py-3 data-[active]:opacity-100"
        ></button>
      ))}
    </div>
  </div>

</section>

<script>
  import { initCarousel } from '../scripts/carousel';
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);
</script>
