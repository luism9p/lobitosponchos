---
// Thin full-width divider with a label on each side.
interface Props {
  left: string;
  right: string;
  number?: string;
  tone?: 'light' | 'dark';
}
const { left, right, number, tone = 'light' } = Astro.props;
const tones = {
  light: 'bg-white text-black border-black',
  dark: 'bg-black text-white border-black',
};
---

<section class:list={['flex w-full flex-wrap items-center justify-between gap-4 border-b-2 px-[22px] py-3.5', tone === 'light' && 'border-t-2', tones[tone]]}>
  <div class="flex items-baseline gap-2.5">
    {number && <span class="font-display text-[22px] leading-none">{number}</span>}
    <span class="text-[11px] font-semibold uppercase tracking-[0.28em]">{left}</span>
  </div>
  <span class="text-[10px] uppercase tracking-[0.28em] opacity-75">{right}</span>
</section>
