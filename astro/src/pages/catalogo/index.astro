---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Chip from '../../components/Chip.astro';
import ProductCard from '../../components/ProductCard.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { categorias } from '../../data/categorias';

const productos = (await getCollection('productos')).sort((a, b) => a.data.orden - b.data.orden);
const filtros = [{ id: 'todos', nombre: 'Todos' }, ...categorias.map((c) => ({ id: c.id, nombre: c.nombre }))];
const tab =
  'cursor-pointer border-[1.5px] border-black bg-white px-3.5 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-black transition-colors hover:bg-black hover:text-white aria-pressed:bg-black aria-pressed:text-white';
---

<BaseLayout
  title="Catálogo"
  description="Ponchos de surf, ponchos kids, fundas y accesorios hechos a mano en Lobitos, Piura. Elige tu modelo y pídelo por WhatsApp."
  variant="solid"
  current="catalogo"
>
  <main>
    <section class="mx-auto max-w-[1180px] px-5 pt-[150px]">
      <Chip class="mb-[22px]">■ Catálogo</Chip>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h1 class="m-0 inline-block border-b-[3px] border-black pb-4 font-display text-[clamp(42px,6.4vw,88px)] font-normal uppercase leading-[.98]">
          Elige tu<br />poncho
        </h1>
        <p class="m-0 max-w-[440px] text-[17px] leading-[1.6] text-pretty">
          Cada pieza se hace a mano y a pedido. Escríbenos por WhatsApp con el modelo que te gustó y coordinamos tallas y colores.
        </p>
      </div>

      <div class="mt-9 flex flex-wrap items-center justify-between gap-4 border-y-[1.5px] border-dashed border-black py-4">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por categoría" data-filters>
          {filtros.map((f) => (
            <button type="button" data-filter={f.id} aria-pressed={f.id === 'todos' ? 'true' : 'false'} class={tab}>{f.nombre}</button>
          ))}
        </div>
        <span class="text-[11px] uppercase tracking-[0.16em] opacity-70" aria-live="polite"><span data-count>{productos.length}</span> productos</span>
      </div>
    </section>

    <section class="mx-auto max-w-[1180px] px-5 pb-24 pt-8">
      <ul class="m-0 grid grid-cols-2 gap-x-3.5 gap-y-9 p-0 split:grid-cols-3 split:gap-x-6">
        {productos.map((producto, i) => <ProductCard producto={producto} eager={i < 4} />)}
      </ul>
      <p data-empty hidden class="mt-10 text-center text-base">Por ahora no hay productos en esta categoría. Escríbenos y lo hacemos a pedido.</p>
    </section>

    <section class="border-y-2 border-black bg-black px-5 py-[70px] text-center text-white">
      <h2 class="mx-auto mb-7 max-w-[820px] font-display text-[clamp(28px,5vw,58px)] font-normal uppercase leading-[1.08]">¿No ves lo que buscas? Lo hacemos a tu medida.</h2>
      <WhatsAppButton variant="outline-white" message="Hola, quiero pedir un poncho hecho a pedido.">Pedir por WhatsApp</WhatsAppButton>
    </section>
  </main>
</BaseLayout>

<script>
  // Category filter. Works on top of the full static list, so the catalogue is complete without JS.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-product]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  function apply(cat: string): void {
    let visible = 0;
    cards.forEach((card) => {
      const show = cat === 'todos' || card.dataset.cat === cat;
      card.hidden = !show;
      if (show) visible++;
    });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible > 0;
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const cat = b.dataset.filter ?? 'todos';
      apply(cat);
      const url = new URL(location.href);
      if (cat === 'todos') url.searchParams.delete('cat');
      else url.searchParams.set('cat', cat);
      history.replaceState(null, '', url);
    }),
  );

  const initial = new URLSearchParams(location.search).get('cat');
  if (initial && [...buttons].some((b) => b.dataset.filter === initial)) apply(initial);
</script>
